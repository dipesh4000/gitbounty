{
  "manifest_version": 3,
  "name": "GitBounty Issue Points",
  "description": "Shows GitBounty point values beside labeled issues on GitHub.",
  "version": "0.1.0",
  "permissions": [],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "include_globs": ["https://github.com/*/*/issues*"],
      "js": ["src/points.js", "src/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
