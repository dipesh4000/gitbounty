{
  "manifest_version": 3,
  "name": "GitBounty Issue Points",
  "description": "Shows GitBounty issue points, contribution activity, and merge rewards on GitHub.",
  "version": "0.2.0",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:8001/*"],
  "action": {
    "default_title": "GitBounty",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "include_globs": [
        "https://github.com/*/*/issues*",
        "https://github.com/*/*/pull*"
      ],
      "js": ["src/points.js", "src/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
