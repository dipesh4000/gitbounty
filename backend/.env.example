# Copy to .env and fill in. .env is gitignored and must never be committed (rules.md section 5).

# GitHub OAuth app credentials. Owned by the login feature (Nishika's).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database. Locally this is the throwaway container in dev/README.md:
#   postgresql://gitbounty:gitbounty_local_dev@localhost:5440/gitbounty_dev
# In a deployed build it is the Supabase connection string, which is a secret.
DATABASE_URL=

# Dev-only stub for the not-yet-built login, see feature-seams.md.
# Leave both empty in any deployed build.
DEV_GITHUB_LOGIN=
DEV_GITHUB_TOKEN=
# GitHub's numeric id for that account. Only matters when working against data that is already seeded --
# leave it at 0 otherwise. Find yours with: curl https://api.github.com/users/<login>
DEV_GITHUB_ID=0
