# Copy to .env and fill in. .env is gitignored and must never be committed (rules.md section 5).

# GitHub OAuth app credentials. Owned by the login feature (Nishika's).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8001/auth/github/callback
FRONTEND_URL=http://localhost:3000

# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Database. Locally this is the throwaway container in dev/README.md:
#   postgresql://gitbounty:gitbounty_local_dev@localhost:5440/gitbounty_dev
# In a deployed build it is the Supabase connection string, which is a secret.
DATABASE_URL=

# Optional dev-only login fallback for backend work without OAuth.
# Leave both empty in any deployed build.
DEV_LOGIN_STUB_ENABLED=false
DEV_GITHUB_LOGIN=
DEV_GITHUB_TOKEN=
# GitHub's numeric id for that account. Only matters when working against data that is already seeded --
# leave it at 0 otherwise. Find yours with: curl https://api.github.com/users/<login>
DEV_GITHUB_ID=0

# Cookie policy. Leave unset locally; set to true in anything deployed. Unset, it falls back to whether
# FRONTEND_URL is https, which is right locally but is one forgotten variable away from shipping a session
# cookie over plain HTTP.
SECURE_COOKIES=false
# Two weeks by default.
SESSION_MAX_AGE_SECONDS=1209600

# --- automated tests only --------------------------------------------------
# These two together mount POST /test-auth/session, which creates a session for any GitHub id without
# going through GitHub. Both are required and both default to the safe value, so neither alone does
# anything. NEVER set either outside an automated test environment. See app/test_auth.py.
#   GITBOUNTY_ENVIRONMENT must be exactly "test" (it defaults to "production")
#   GITBOUNTY_TEST_AUTH_SECRET must be at least 16 characters
GITBOUNTY_ENVIRONMENT=production
GITBOUNTY_TEST_AUTH_SECRET=

# Logging. JSON_LOGS=false gives a plain format when a human is reading the terminal.
LOG_LEVEL=INFO
JSON_LOGS=true

# Who may review and resolve moderation flags: a comma-separated list of stable GitHub NUMERIC ids
# (not logins -- a person can change a login). Empty means NOBODY is an administrator and every
# moderation endpoint answers 403. Find an id with: curl https://api.github.com/users/<login>
ADMIN_GITHUB_IDS=

# GitHub App: server-only RSA key file outside the repository.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Owner-funded Avalanche payouts through required SmoothSend. Test with official Fuji USDC.
# Apply migrations through 0016; allow the exact frontend origin in SmoothSend.
AVAX_PAYMENTS_ENABLED=true
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
PAYMENT_MODE=usdc_fuji
# Public dashboard key only (pk_nogas_...). Empty disables execution. Never use a secret key.
SMOOTHSEND_PUBLIC_KEY=
SMOOTHSEND_FEE_LIMIT_USDC=0.1
